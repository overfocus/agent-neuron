{
  "name": "agent-neuron",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental agent graph: a universal container each agent runs in, with many-to-many links between neurons.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run -s build && node examples/first.mjs",
    "demo:typing": "npm run -s build && node examples/typing.mjs",
    "demo:suggest": "npm run -s build && node examples/suggest.mjs",
    "demo:alerts": "npm run -s build && node examples/alerts.mjs",
    "demo:loop": "npm run -s build && node examples/loop.mjs",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "demo:rust": "npm run -s build && npm run -s rust:build && node examples/rust.mjs",
    "demo:composed": "npm run -s build && npm run -s rust:build && node examples/composed.mjs",
    "check": "npm run -s typecheck && npm run -s rust:test && npm run -s rust:build && npm run -s test && npm run -s build",
    "view": "npm run -s build && node examples/view/server.mjs",
    "record": "npm run -s build && node examples/trace/record.mjs",
    "check:browser": "node scripts/kit.mjs check-browser",
    "check:layout": "node scripts/kit.mjs check-layout",
    "verify": "node scripts/kit.mjs verify",
    "verify:receipt": "node scripts/kit.mjs verify-receipt",
    "ship": "node scripts/kit.mjs ship",
    "wt": "node scripts/kit.mjs wt",
    "ships": "node scripts/kit.mjs ships",
    "issue": "node scripts/kit.mjs issue"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
