{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-neuron:schema:network:0",
  "title": "agent-neuron network file, version 0 (specification 0.1)",
  "description": "Closed schema: an unknown field is an error. Values are literals; nothing in the file reads a payload. A `neuron` entry names a neuron's own file (spec/neuron.schema.json), which `check` reads: the schema cannot. See docs/SPEC.md section 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "neurons"
  ],
  "dependentRequired": {
    "entry": [
      "exit"
    ],
    "exit": [
      "entry"
    ]
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/id"
    },
    "exit": {
      "$ref": "#/$defs/id"
    },
    "neurons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/neuron"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "budget": {
      "description": "The most one trace may spend, in named units. With a budget, every neuron but a source declares a cost (0 allowed); `check` enforces it, as a schema cannot. See docs/SPEC.md section 10.",
      "$ref": "#/$defs/units"
    },
    "ground": {
      "description": "The link layer's strength (SPEC 4.5, decision 0012): deposits kept per place, evaporation, and one-link routing for replies that name no `to`.",
      "$ref": "#/$defs/ground"
    }
  },
  "$defs": {
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deposit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on",
            "add"
          ],
          "properties": {
            "by": {
              "$ref": "#/$defs/id"
            },
            "on": {
              "$ref": "#/$defs/id"
            },
            "add": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "evaporate": {
          "type": "number",
          "minimum": 0
        },
        "select": {
          "const": true
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "power": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "literal": {
      "description": "A literal string. Catches the common interpolation syntaxes (${...}, {{...}}); it cannot prove a string is not an expression, so the rule in the spec is the real check.",
      "type": "string",
      "not": {
        "pattern": "\\$\\{|\\{\\{"
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/literal"
      }
    },
    "ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "humanMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "description": "A human neuron's timeout: up to a day (decision 0008); every other kind is capped at an hour."
    },
    "inflight": {
      "type": "integer",
      "minimum": 1,
      "description": "The most calls of the neuron at once; the rest wait in arrival order (SPEC 2.4, decision 0021). Absent: no limit."
    },
    "each": {
      "const": true,
      "description": "The answer is a JSON array, and each item is forwarded as a signal of its own, in order (SPEC 2.4, 4.4, decision 0022). Absent: one answer, one forward."
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "neuron": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "source": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "run"
          ],
          "dependentRequired": {
            "within": [
              "threshold"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "run": {
              "$ref": "#/$defs/command"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within": {
              "$ref": "#/$defs/ms"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/ms"
            },
            "maxInflight": {
              "$ref": "#/$defs/inflight"
            },
            "env": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "cwd": {
              "$ref": "#/$defs/literal"
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "effect": {
              "const": true
            },
            "each": {
              "$ref": "#/$defs/each"
            },
            "may": {
              "$ref": "#/$defs/may"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "serve"
          ],
          "dependentRequired": {
            "within": [
              "threshold"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "serve": {
              "$ref": "#/$defs/command"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within": {
              "$ref": "#/$defs/ms"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/ms"
            },
            "env": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "cwd": {
              "$ref": "#/$defs/literal"
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "effect": {
              "const": true
            },
            "each": {
              "$ref": "#/$defs/each"
            },
            "may": {
              "$ref": "#/$defs/may"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "http"
          ],
          "dependentRequired": {
            "within": [
              "threshold"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "http": {
              "allOf": [
                {
                  "$ref": "#/$defs/literal"
                },
                {
                  "pattern": "^https?://"
                }
              ]
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within": {
              "$ref": "#/$defs/ms"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/ms"
            },
            "maxInflight": {
              "$ref": "#/$defs/inflight"
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "effect": {
              "const": true
            },
            "each": {
              "$ref": "#/$defs/each"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "human"
          ],
          "dependentRequired": {
            "within": [
              "threshold"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "human": {
              "const": true
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within": {
              "$ref": "#/$defs/ms"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/humanMs"
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "effect": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "network"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "network": {
              "$ref": "#/$defs/literal"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/ms"
            },
            "maxInflight": {
              "$ref": "#/$defs/inflight"
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "may": {
              "$ref": "#/$defs/may"
            },
            "each": {
              "$ref": "#/$defs/each"
            },
            "effect": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "neuron"
          ],
          "dependentRequired": {
            "within": [
              "threshold"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "neuron": {
              "$ref": "#/$defs/literal"
            },
            "args": {
              "description": "Arguments appended to the command of the neuron's file, after its own (SPEC 2.10, decision 0022). Only where that file is a `run` or `serve` neuron; `check` enforces it, as a schema cannot.",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            },
            "threshold": {
              "type": "integer",
              "minimum": 1
            },
            "within": {
              "$ref": "#/$defs/ms"
            },
            "maxHops": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "$ref": "#/$defs/humanMs"
            },
            "maxInflight": {
              "$ref": "#/$defs/inflight"
            },
            "env": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "cost": {
              "$ref": "#/$defs/units"
            },
            "may": {
              "$ref": "#/$defs/may"
            }
          }
        }
      ]
    },
    "units": {
      "description": "Named units with whole-number amounts. Amounts stay within 2^53 - 1, so every JSON reader holds them exactly.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "position": {
      "type": "array",
      "description": "Where a drawing puts the neuron: x, y, z, in any unit the file's author chooses. A descriptive field (SPEC 2.2, decision 0011): no engine acts on it.",
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "hostPort": {
      "description": "A host or address and a port, `host:port`: lower-case letters, digits, dots and hyphens, then a port from 1 to 65535. No wildcard.",
      "allOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        }
      ]
    },
    "path": {
      "description": "A path, as written: a literal, not empty.",
      "allOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "minLength": 1
        }
      ]
    },
    "may": {
      "description": "What the neuron's program is allowed to touch (SPEC 2.4, decision 0016). Absent, or a member absent, grants nothing. On a `network` neuron it declares what its inside may touch; `check` enforces that it covers the inside, as a schema cannot.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connect": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostPort"
          }
        },
        "listen": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostPort"
          }
        },
        "read": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}
