{
  "fixture": 0,
  "description": "A level 1 neuron with threshold 2 gets the envelope in its signal message; a plain level 1 neuron gets the bare payload.",
  "inputs": [
    {"at":0,"source":"s","payload":1}
  ],
  "script": {
    "d1": {"calls":[{"after":10,"reply":{"answer":"a"}}]},
    "d2": {"calls":[{"after":20,"reply":{"answer":"b"}}]},
    "h": {"calls":[{"when":{"payload":"b","inputs":["a","b"]},"after":5,"reply":{"answer":"both"}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["d1","d2"],"trace":"#1","hops":0,"payload":{"type":"json","data":1}},
    {"type":"answer","t":10,"id":"#2","from":"d1","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"a"}},
    {"type":"signal","t":10,"id":"#3","from":"d1","to":["h"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"text","text":"a"}},
    {"type":"answer","t":20,"id":"#4","from":"d2","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"b"}},
    {"type":"signal","t":20,"id":"#5","from":"d2","to":["h"],"trace":"#1","cause":"#4","hops":2,"payload":{"type":"text","text":"b"}},
    {"type":"answer","t":25,"id":"#6","from":"h","to":["d2"],"trace":"#1","replyTo":"#5","hops":3,"payload":{"type":"text","text":"both"}}
  ]
}
