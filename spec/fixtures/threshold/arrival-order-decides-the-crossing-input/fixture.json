{
  "fixture": 0,
  "description": "The input that arrives last crosses, whichever sender it is: inputs are in arrival order and the answer goes to the last sender.",
  "inputs": [
    {"at":0,"source":"s","payload":{"n":1}}
  ],
  "script": {
    "d1": {"calls":[{"after":30,"reply":{"answer":{"d":1}}}]},
    "d2": {"calls":[{"after":10,"reply":{"answer":{"d":2}}}]},
    "h": {"calls":[{"when":{"payload":{"d":1},"inputs":[{"d":2},{"d":1}]},"after":5,"reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["d1","d2"],"trace":"#1","hops":0,"payload":{"type":"json","data":{"n":1}}},
    {"type":"answer","t":10,"id":"#2","from":"d2","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"json","data":{"d":2}}},
    {"type":"signal","t":10,"id":"#3","from":"d2","to":["h"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"json","data":{"d":2}}},
    {"type":"answer","t":30,"id":"#4","from":"d1","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"json","data":{"d":1}}},
    {"type":"signal","t":30,"id":"#5","from":"d1","to":["h"],"trace":"#1","cause":"#4","hops":2,"payload":{"type":"json","data":{"d":1}}},
    {"type":"quiet","t":35,"id":"#6","from":"h","to":["d1"],"trace":"#1","replyTo":"#5","hops":3}
  ]
}
