{
  "fixture": 0,
  "description": "Calls that end at the same instant are processed in the order they started; each reply is followed by its own forward.",
  "inputs": [
    {"at":0,"source":"s","payload":1}
  ],
  "script": {
    "a": {"calls":[{"after":20,"reply":{"answer":"A"}}]},
    "b": {"calls":[{"after":20,"reply":{"answer":"B"}}]},
    "c": {"calls":[{"when":"A","after":1,"reply":{"quiet":true}},{"when":"B","after":1,"reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a","b"],"trace":"#1","hops":0,"payload":{"type":"json","data":1}},
    {"type":"answer","t":20,"id":"#2","from":"a","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"A"}},
    {"type":"signal","t":20,"id":"#3","from":"a","to":["c"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"text","text":"A"}},
    {"type":"answer","t":20,"id":"#4","from":"b","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"B"}},
    {"type":"signal","t":20,"id":"#5","from":"b","to":["c"],"trace":"#1","cause":"#4","hops":2,"payload":{"type":"text","text":"B"}},
    {"type":"quiet","t":21,"id":"#6","from":"c","to":["a"],"trace":"#1","replyTo":"#3","hops":3},
    {"type":"quiet","t":21,"id":"#7","from":"c","to":["b"],"trace":"#1","replyTo":"#5","hops":3}
  ]
}
