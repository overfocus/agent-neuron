{
  "fixture": 0,
  "description": "A running drop is reported when the work goes stale; the cancel note follows it.",
  "notes": true,
  "inputs": [
    {"at":0,"source":"s","payload":"old","replaces":"k"},
    {"at":40,"source":"s","payload":"new","replaces":"k"}
  ],
  "script": {
    "a": {"calls":[{"when":"old","after":100,"onCancel":{"after":0,"reply":{"quiet":true}},"reply":{"quiet":true}},{"when":"new","after":5,"reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"replaces":"k","payload":{"type":"text","text":"old"}},
    {"type":"signal","t":40,"id":"#2","from":"s","to":["a"],"trace":"#2","hops":0,"replaces":"k","payload":{"type":"text","text":"new"}},
    {"type":"drop","t":40,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","reason":"replaced","phase":"running","payload":{"type":"text","text":"old"}},
    {"type":"note","t":40,"neuron":"a","what":"cancel"},
    {"type":"quiet","t":45,"id":"#3","from":"a","to":["s"],"trace":"#2","replyTo":"#2","hops":1}
  ]
}
