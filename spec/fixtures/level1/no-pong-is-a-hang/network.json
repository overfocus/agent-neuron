{
  "version": 0,
  "name": "no-pong-is-a-hang",
  "description": "An idle neuron that does not pong within timeout is hung: killed (term) and restarted after the backoff.",
  "neurons": [
    {
      "id": "s",
      "source": true
    },
    {
      "id": "a",
      "serve": [
        "neuron-a"
      ],
      "timeout": 300
    },
    {
      "id": "b",
      "run": [
        "neuron-b"
      ]
    }
  ],
  "links": [
    {
      "from": "s",
      "to": "a"
    },
    {
      "from": "s",
      "to": "b"
    }
  ]
}
