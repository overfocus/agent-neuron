{
  "version": 0,
  "name": "a-busy-neuron-is-not-pinged",
  "description": "Ping is sent only when nothing is running: a neuron busy for 3500 ms that would never pong is not hung.",
  "neurons": [
    {
      "id": "s",
      "source": true
    },
    {
      "id": "a",
      "serve": [
        "neuron-a"
      ],
      "timeout": 5000
    },
    {
      "id": "b",
      "run": [
        "neuron-b"
      ]
    }
  ],
  "links": [
    {
      "from": "s",
      "to": "a"
    },
    {
      "from": "s",
      "to": "b"
    }
  ]
}
