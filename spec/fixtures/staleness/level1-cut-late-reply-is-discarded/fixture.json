{
  "fixture": 0,
  "description": "A neuron that ignores cancel and answers anyway: the answer is discarded and nothing is forwarded; with maxInflight 2 the new call runs meanwhile.",
  "inputs": [
    {"at":0,"source":"s","payload":"old","replaces":"k"},
    {"at":40,"source":"s","payload":"new","replaces":"k"}
  ],
  "script": {
    "a": {"starts":[{"maxInflight":2}],"calls":[{"when":"old","after":60,"reply":{"answer":"old"}},{"when":"new","after":50,"reply":{"answer":"new"}}]},
    "b": {"calls":[{"when":"new","reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"replaces":"k","payload":{"type":"text","text":"old"}},
    {"type":"signal","t":40,"id":"#2","from":"s","to":["a"],"trace":"#2","hops":0,"replaces":"k","payload":{"type":"text","text":"new"}},
    {"type":"drop","t":40,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","reason":"replaced","phase":"running","payload":{"type":"text","text":"old"}},
    {"type":"answer","t":90,"id":"#3","from":"a","to":["s"],"trace":"#2","replyTo":"#2","hops":1,"payload":{"type":"text","text":"new"}},
    {"type":"signal","t":90,"id":"#4","from":"a","to":["b"],"trace":"#2","cause":"#3","hops":2,"replaces":"k","payload":{"type":"text","text":"new"}},
    {"type":"quiet","t":90,"id":"#5","from":"b","to":["a"],"trace":"#2","replyTo":"#4","hops":3}
  ]
}
