    {"type":"drop","t":10,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","reason":"replaced","phase":"running","payload":{"type":"text","text":"old"}},
    {"type":"signal","t":100,"id":"#3","from":"s","to":["a"],"trace":"#3","hops":0,"replaces":"j","payload":{"type":"text","text":"later"}},
