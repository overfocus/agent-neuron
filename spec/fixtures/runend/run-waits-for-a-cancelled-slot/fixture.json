    {"at":10,"source":"s","payload":"new","replaces":"k"},
    {"at":100,"source":"s","payload":"later","replaces":"j"}
  ],
  "script": {
    "a": {"calls":[{"when":"old","after":1000,"onCancel":{"after":500,"reply":{"quiet":true}},"reply":{"quiet":true}},{"when":"new","after":10,"reply":{"answer":"n"}},{"when":"later","after":10,"reply":{"answer":"l"}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"replaces":"k","payload":{"type":"text","text":"old"}},
