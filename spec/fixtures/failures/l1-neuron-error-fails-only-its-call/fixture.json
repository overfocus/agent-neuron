{
  "fixture": 0,
  "description": "Two level 1 calls at once: the one the neuron answers with an error fails with code neuron; the other answers and forwards.",
  "inputs": [
    {"at":0,"source":"s","payload":1},
    {"at":0,"source":"s","payload":2}
  ],
  "script": {
    "a": {"starts":[{"maxInflight":2}],"calls":[{"when":1,"after":10,"reply":{"error":"no model"}},{"when":2,"after":20,"reply":{"answer":"two"}}]},
    "b": {"calls":[{"after":1,"reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"payload":{"type":"json","data":1}},
    {"type":"signal","t":0,"id":"#2","from":"s","to":["a"],"trace":"#2","hops":0,"payload":{"type":"json","data":2}},
    {"type":"error","t":10,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","message":"no model","code":"neuron","payload":{"type":"json","data":1}},
    {"type":"answer","t":20,"id":"#3","from":"a","to":["s"],"trace":"#2","replyTo":"#2","hops":1,"payload":{"type":"text","text":"two"}},
    {"type":"signal","t":20,"id":"#4","from":"a","to":["b"],"trace":"#2","cause":"#3","hops":2,"payload":{"type":"text","text":"two"}},
    {"type":"quiet","t":21,"id":"#5","from":"b","to":["a"],"trace":"#2","replyTo":"#4","hops":3}
  ]
}
