{
  "fixture": 0,
  "description": "If the neuron never replies to the cancel either, after timeout more ms the process is treated as hung: killed (term) and restarted.",
  "notes": true,
  "inputs": [
    {"at":0,"source":"s","payload":1},
    {"at":450,"source":"s","payload":2}
  ],
  "script": {
    "a": {"calls":[{"when":1,"after":0,"reply":{"hang":true}},{"when":2,"after":5,"reply":{"answer":"two"}}],"starts":[{},{}]},
    "b": {"calls":[{"reply":{"quiet":true}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"payload":{"type":"json","data":1}},
    {"type":"error","t":100,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","message":"timed out after 100 ms","code":"timeout","payload":{"type":"json","data":1}},
    {"type":"note","t":100,"neuron":"a","what":"cancel"},
    {"type":"note","t":200,"neuron":"a","what":"term"},
    {"type":"note","t":400,"neuron":"a","what":"restart"},
    {"type":"signal","t":450,"id":"#2","from":"s","to":["a"],"trace":"#2","hops":0,"payload":{"type":"json","data":2}},
    {"type":"answer","t":455,"id":"#3","from":"a","to":["s"],"trace":"#2","replyTo":"#2","hops":1,"payload":{"type":"text","text":"two"}},
    {"type":"signal","t":455,"id":"#4","from":"a","to":["b"],"trace":"#2","cause":"#3","hops":2,"payload":{"type":"text","text":"two"}},
    {"type":"quiet","t":455,"id":"#5","from":"b","to":["a"],"trace":"#2","replyTo":"#4","hops":3}
  ]
}
