{
  "fixture": 0,
  "description": "A scripted observer is shown `finished` events as well as events with an id: this one injects after the first trace finishes; the note names the trace as its trigger.",
  "notes": true,
  "finished": true,
  "inputs": [
    {"at":0,"source":"s","payload":1}
  ],
  "script": {
    "a": {"calls":[{"after":10,"reply":{"answer":"one"}},{"after":10,"reply":{"answer":"two"}}]}
  },
  "observer": [
    {"when":{"type":"finished"},"inject":{"after":5,"source":"s","payload":2}}
  ],
  "independent": true,
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"payload":{"type":"json","data":1}},
    {"type":"answer","t":10,"id":"#2","from":"a","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"one"}},
    {"type":"finished","t":10,"trace":"#1","status":"done"},
    {"type":"note","t":15,"neuron":"s","what":"inject","trigger":"#1"},
    {"type":"signal","t":15,"id":"#3","from":"s","to":["a"],"trace":"#3","hops":0,"payload":{"type":"json","data":2}},
    {"type":"answer","t":25,"id":"#4","from":"a","to":["s"],"trace":"#3","replyTo":"#3","hops":1,"payload":{"type":"text","text":"two"}},
    {"type":"finished","t":25,"trace":"#3","status":"done"}
  ]
}
