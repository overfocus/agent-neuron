{
  "fixture": 0,
  "description": "Events before an observer's first injection never differ; after it, an injection with a key replaces earlier work like any producer's.",
  "inputs": [
    {"at":0,"source":"s","payload":{"n":1},"replaces":"k"}
  ],
  "script": {
    "a": {"calls":[{"after":100,"reply":{"answer":{"n":"old"}}},{"after":10,"reply":{"answer":{"n":"new"}}}]},
    "b": {"calls":[{"after":5,"reply":{"quiet":true}}]}
  },
  "observer": [
    {"when":{"type":"signal","from":"s"},"inject":{"after":40,"source":"s","payload":{"n":2},"replaces":"k"}}
  ],
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"replaces":"k","payload":{"type":"json","data":{"n":1}}},
    {"type":"signal","t":40,"id":"#2","from":"s","to":["a"],"trace":"#2","hops":0,"replaces":"k","payload":{"type":"json","data":{"n":2}}},
    {"type":"drop","t":40,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"neuron":"a","reason":"replaced","phase":"running","payload":{"type":"json","data":{"n":1}}},
    {"type":"answer","t":50,"id":"#3","from":"a","to":["s"],"trace":"#2","replyTo":"#2","hops":1,"payload":{"type":"json","data":{"n":"new"}}},
    {"type":"signal","t":50,"id":"#4","from":"a","to":["b"],"trace":"#2","cause":"#3","hops":2,"replaces":"k","payload":{"type":"json","data":{"n":"new"}}},
    {"type":"quiet","t":55,"id":"#5","from":"b","to":["a"],"trace":"#2","replyTo":"#4","hops":3}
  ],
  "expectWithout": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a"],"trace":"#1","hops":0,"replaces":"k","payload":{"type":"json","data":{"n":1}}},
    {"type":"answer","t":100,"id":"#2","from":"a","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"json","data":{"n":"old"}}},
    {"type":"signal","t":100,"id":"#3","from":"a","to":["b"],"trace":"#1","cause":"#2","hops":2,"replaces":"k","payload":{"type":"json","data":{"n":"old"}}},
    {"type":"quiet","t":105,"id":"#4","from":"b","to":["a"],"trace":"#1","replyTo":"#3","hops":3}
  ]
}
