{
  "fixture": 0,
  "description": "Reconciliation is an injection, not engine machinery: the observer sees the unknown event of a crashed effect call and injects, into the declared source `reconcile`, the id the original payload carried; `lookup` then answers whether it happened.",
  "notes": true,
  "inputs": [
    {"at":0,"source":"s","payload":{"id":"n-1","text":"hello"}}
  ],
  "script": {
    "notify": {"calls":[{"after":20,"reply":{"crash":true}}]},
    "lookup": {"calls":[{"when":{"id":"n-1"},"after":5,"reply":{"answer":{"id":"n-1","sent":true}}}]}
  },
  "observer": [
    {"when":{"type":"unknown","neuron":"notify"},"inject":{"after":10,"source":"reconcile","payload":{"id":"n-1"}}}
  ],
  "independent": true,
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["notify"],"trace":"#1","hops":0,"payload":{"type":"json","data":{"id":"n-1","text":"hello"}}},
    {"type":"unknown","t":20,"id":"#1","from":"s","to":["notify"],"trace":"#1","hops":0,"neuron":"notify","message":"signal SIGKILL:","code":"exit","payload":{"type":"json","data":{"id":"n-1","text":"hello"}}},
    {"type":"note","t":30,"neuron":"reconcile","what":"inject","trigger":"#1"},
    {"type":"signal","t":30,"id":"#2","from":"reconcile","to":["lookup"],"trace":"#2","hops":0,"payload":{"type":"json","data":{"id":"n-1"}}},
    {"type":"answer","t":35,"id":"#3","from":"lookup","to":["reconcile"],"trace":"#2","replyTo":"#2","hops":1,"payload":{"type":"json","data":{"id":"n-1","sent":true}}}
  ]
}
