{
  "fixture": 0,
  "description": "A threshold counts senders (5.2), so the items of one answer do not add up at a threshold neuron: each newer item replaces the held one of the same sender (drop replaced, phase waiting), and h acts only when p, a second sender, arrives, with the last item and p's input.",
  "inputs": [
    {"at":0,"source":"s","payload":0}
  ],
  "script": {
    "a": {"calls":[{"after":10,"reply":{"answer":[1,2,3]}}]},
    "p": {"calls":[{"after":20,"reply":{"answer":"p"}}]},
    "h": {"calls":[{"when":{"payload":"p","inputs":[3,"p"]},"after":5,"reply":{"answer":"h"}}]}
  },
  "expect": [
    {"type":"signal","t":0,"id":"#1","from":"s","to":["a","p"],"trace":"#1","hops":0,"payload":{"type":"json","data":0}},
    {"type":"answer","t":10,"id":"#2","from":"a","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"json","data":[1,2,3]}},
    {"type":"signal","t":10,"id":"#3","from":"a","to":["h"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"json","data":1}},
    {"type":"signal","t":10,"id":"#4","from":"a","to":["h"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"json","data":2}},
    {"type":"drop","t":10,"id":"#3","from":"a","to":["h"],"trace":"#1","cause":"#2","hops":2,"neuron":"h","reason":"replaced","phase":"waiting","payload":{"type":"json","data":1}},
    {"type":"signal","t":10,"id":"#5","from":"a","to":["h"],"trace":"#1","cause":"#2","hops":2,"payload":{"type":"json","data":3}},
    {"type":"drop","t":10,"id":"#4","from":"a","to":["h"],"trace":"#1","cause":"#2","hops":2,"neuron":"h","reason":"replaced","phase":"waiting","payload":{"type":"json","data":2}},
    {"type":"answer","t":20,"id":"#6","from":"p","to":["s"],"trace":"#1","replyTo":"#1","hops":1,"payload":{"type":"text","text":"p"}},
    {"type":"signal","t":20,"id":"#7","from":"p","to":["h"],"trace":"#1","cause":"#6","hops":2,"payload":{"type":"text","text":"p"}},
    {"type":"answer","t":25,"id":"#8","from":"h","to":["p"],"trace":"#1","replyTo":"#7","hops":3,"payload":{"type":"text","text":"h"}}
  ]
}
